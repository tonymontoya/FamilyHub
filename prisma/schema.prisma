// Family Hub - Database Schema
// v0.1 MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Member[]
  chores  Chore[]
  todos   Todo[]
  lists   List[]
  events  CalendarEvent[]

  @@map("families")
}

model Member {
  id          String    @id @default(uuid())
  familyId    String    @map("family_id")
  userId      String    @unique @map("user_id")
  role        Role
  username    String    @unique
  displayName String    @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  family              Family             @relation(fields: [familyId], references: [id])
  user                User               @relation(fields: [userId], references: [id])
  completions         Completion[]
  approvedCompletions Completion[]       @relation("CompletionApprover")
  todos               Todo[]
  points              PointTransaction[]
  assignedChores      Chore[]
  createdLists        List[]             @relation("ListCreator")
  completedListItems  ListItem[]         @relation("ListItemCompleter")
  createdEvents       CalendarEvent[]    @relation("EventCreator")
  eventAttendees      EventAttendee[]

  @@index([familyId, role])
  @@map("members")
}

model Chore {
  id             String      @id @default(uuid())
  familyId       String      @map("family_id")
  title          String
  description    String?
  points         Int         @default(0)
  recurrenceRule String?     @map("recurrence_rule")
  assigneeId     String?     @map("assignee_id")
  status         ChoreStatus @default(ACTIVE)
  createdBy      String      @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  family      Family       @relation(fields: [familyId], references: [id])
  assignee    Member?      @relation(fields: [assigneeId], references: [id])
  completions Completion[]

  @@index([familyId, status, assigneeId])
  @@index([familyId, recurrenceRule])
  @@map("chores")
}

model Completion {
  id            String           @id @default(uuid())
  choreId       String           @map("chore_id")
  memberId      String           @map("member_id")
  completedAt   DateTime         @default(now()) @map("completed_at")
  scheduledFor  DateTime?        @map("scheduled_for")
  photoUrl      String?          @map("photo_url")
  notes         String?
  approvedBy    String?          @map("approved_by")
  approvedAt    DateTime?        @map("approved_at")
  pointsAwarded Int?             @map("points_awarded")
  status        CompletionStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  chore    Chore   @relation(fields: [choreId], references: [id])
  member   Member  @relation(fields: [memberId], references: [id])
  approver Member? @relation("CompletionApprover", fields: [approvedBy], references: [id])

  // Unique constraint for idempotency: one completion per chore per member per day
  @@unique([choreId, memberId, scheduledFor], name: "unique_completion_per_day")
  @@index([choreId, memberId, completedAt])
  @@index([memberId, status])
  @@index([choreId, status])
  @@map("completions")
}

model Todo {
  id          String     @id @default(uuid())
  familyId    String     @map("family_id")
  title       String
  notes       String?
  assigneeId  String?    @map("assignee_id")
  dueDate     DateTime?  @map("due_date")
  status      TodoStatus @default(ACTIVE)
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  completedAt DateTime?  @map("completed_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  family   Family  @relation(fields: [familyId], references: [id])
  assignee Member? @relation(fields: [assigneeId], references: [id])

  @@index([familyId, assigneeId, status])
  @@index([dueDate])
  @@map("todos")
}

model List {
  id          String    @id @default(uuid())
  familyId    String    @map("family_id")
  title       String    @db.VarChar(100)
  type        ListType  @default(CUSTOM)
  description String?   @db.VarChar(500)
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  family    Family     @relation(fields: [familyId], references: [id])
  items     ListItem[]
  createdBy Member     @relation("ListCreator", fields: [createdById], references: [id])

  @@index([familyId, type])
  @@index([familyId, deletedAt])
  @@index([updatedAt])
  @@map("lists")
}

model ListItem {
  id          String    @id @default(uuid())
  listId      String    @map("list_id")
  name        String    @db.VarChar(100)
  quantity    Int       @default(1)
  notes       String?   @db.VarChar(200)
  completed   Boolean   @default(false)
  completedBy String?   @map("completed_by_id")
  completedAt DateTime? @map("completed_at")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  list      List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  completer Member? @relation("ListItemCompleter", fields: [completedBy], references: [id])

  @@index([listId, completed])
  @@index([listId, deletedAt])
  @@index([sortOrder])
  @@index([completedBy])
  @@map("list_items")
}

model PointTransaction {
  id          String    @id @default(uuid())
  memberId    String    @map("member_id")
  amount      Int
  type        PointType
  referenceId String?   @map("reference_id")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
  @@map("point_transactions")
}

// Enums

enum Role {
  PARENT
  CHILD
}

enum ChoreStatus {
  ACTIVE
  ARCHIVED
}

enum CompletionStatus {
  PENDING
  APPROVED
  DECLINED
}

enum TodoStatus {
  ACTIVE
  COMPLETED
}

enum PointType {
  EARNED
  REDEEMED
}

enum ListType {
  SHOPPING
  PACKING
  WISHLIST
  CUSTOM
}

// ========== CALENDAR MODULE ==========

model CalendarEvent {
  id              String           @id @default(uuid())
  familyId        String           @map("family_id")
  title           String           @db.VarChar(200)
  description     String?          @db.VarChar(2000)
  
  // Timing - split date/time for all-day event support
  startDate       DateTime         @map("start_date")
  startTime       DateTime?        @map("start_time") // null = all-day
  endDate         DateTime?        @map("end_date")   // for multi-day
  endTime         DateTime?        @map("end_time")
  timezone        String           @default("UTC")
  
  // Recurrence
  isRecurring     Boolean          @default(false) @map("is_recurring")
  recurrenceRule  String?          @map("recurrence_rule") // RRULE format
  recurrenceEnd   DateTime?        @map("recurrence_end")
  
  // Assignment & visibility
  createdById     String           @map("created_by_id")
  assigneeIds     String[]         @map("assignee_ids")
  isFamilyWide    Boolean          @default(true) @map("is_family_wide")
  
  // Event type & metadata
  type            EventType        @default(EVENT)
  location        String?          @db.VarChar(500)
  color           String?          @db.VarChar(7)      // hex color
  
  // Soft delete & timestamps
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  
  // Relations
  family          Family           @relation(fields: [familyId], references: [id])
  createdBy       Member           @relation("EventCreator", fields: [createdById], references: [id])
  attendees       EventAttendee[]
  exceptions      EventException[]
  reminders       EventReminder[]
  
  @@index([familyId, startDate])
  @@index([familyId, deletedAt])
  @@index([familyId, updatedAt])
  @@index([isRecurring, recurrenceEnd])
  @@map("calendar_events")
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  memberId  String   @map("member_id")
  status    AttendeeStatus @default(ACCEPTED)
  createdAt DateTime @default(now()) @map("created_at")
  
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member    Member        @relation(fields: [memberId], references: [id])
  
  @@unique([eventId, memberId])
  @@index([memberId])
  @@map("event_attendees")
}

model EventException {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  originalDate DateTime  @map("original_date")
  
  // Modified fields (null = no change)
  title       String?   @db.VarChar(200)
  description String?   @db.VarChar(2000)
  startTime   DateTime? @map("start_time")
  endTime     DateTime? @map("end_time")
  location    String?   @db.VarChar(500)
  isCancelled Boolean   @default(false) @map("is_cancelled")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@unique([eventId, originalDate])
  @@map("event_exceptions")
}

model EventReminder {
  id             String         @id @default(uuid())
  eventId        String         @map("event_id")
  minutesBefore  Int            @map("minutes_before")
  type           ReminderType   @default(BROWSER)
  isSent         Boolean        @default(false) @map("is_sent")
  sentAt         DateTime?      @map("sent_at")
  isAcknowledged Boolean        @default(false) @map("is_acknowledged")
  acknowledgedAt DateTime?      @map("acknowledged_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  
  event          CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@index([eventId, isSent])
  @@index([isSent, sentAt])
  @@index([isAcknowledged, isSent])
  @@map("event_reminders")
}

// Calendar Enums
enum EventType {
  EVENT
  APPOINTMENT
  ACTIVITY
  BIRTHDAY
  HOLIDAY
  REMINDER
}

enum AttendeeStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum ReminderType {
  BROWSER
  EMAIL
  PUSH
}

// ========== AUTH MODELS (Better Auth) ==========

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  accounts        Account[]
  member          Member?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
