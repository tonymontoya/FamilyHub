// Family Hub - Database Schema
// v0.1 MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Member[]
  chores  Chore[]
  todos   Todo[]

  @@map("families")
}

model Member {
  id          String    @id @default(uuid())
  familyId    String    @map("family_id")
  role        Role
  username    String    @unique
  displayName String    @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  family       Family       @relation(fields: [familyId], references: [id])
  completions  Completion[]
  todos        Todo[]
  points       PointTransaction[]
  assignedChores Chore[]

  @@index([familyId, role])
  @@map("members")
}

model Chore {
  id              String            @id @default(uuid())
  familyId        String            @map("family_id")
  title           String
  description     String?
  points          Int               @default(0)
  recurrenceRule  String?           @map("recurrence_rule")
  assigneeId      String?           @map("assignee_id")
  status          ChoreStatus       @default(ACTIVE)
  createdBy       String            @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  family      Family       @relation(fields: [familyId], references: [id])
  assignee    Member?      @relation(fields: [assigneeId], references: [id])
  completions Completion[]

  @@index([familyId, status, assigneeId])
  @@index([familyId, recurrenceRule])
  @@map("chores")
}

model Completion {
  id            String          @id @default(uuid())
  choreId       String          @map("chore_id")
  memberId      String          @map("member_id")
  completedAt   DateTime        @default(now()) @map("completed_at")
  photoUrl      String?         @map("photo_url")
  approvedBy    String?         @map("approved_by")
  approvedAt    DateTime?       @map("approved_at")
  pointsAwarded Int?            @map("points_awarded")
  status        CompletionStatus @default(PENDING)
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")

  chore  Chore  @relation(fields: [choreId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([choreId, createdAt])
  @@index([memberId, status])
  @@map("completions")
}

model Todo {
  id          String     @id @default(uuid())
  familyId    String     @map("family_id")
  title       String
  notes       String?
  assigneeId  String?    @map("assignee_id")
  dueDate     DateTime?  @map("due_date")
  status      TodoStatus @default(ACTIVE)
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  completedAt DateTime?  @map("completed_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  family   Family  @relation(fields: [familyId], references: [id])
  assignee Member? @relation(fields: [assigneeId], references: [id])

  @@index([familyId, assigneeId, status])
  @@index([dueDate])
  @@map("todos")
}

model PointTransaction {
  id          String    @id @default(uuid())
  memberId    String    @map("member_id")
  amount      Int
  type        PointType
  referenceId String?   @map("reference_id")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
  @@map("point_transactions")
}

// Enums
enum Role {
  PARENT
  CHILD
}

enum ChoreStatus {
  ACTIVE
  ARCHIVED
}

enum CompletionStatus {
  PENDING
  APPROVED
  DECLINED
}

enum TodoStatus {
  ACTIVE
  COMPLETED
}

enum PointType {
  EARNED
  REDEEMED
}
