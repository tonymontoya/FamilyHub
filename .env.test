# Family Hub - Test Environment
# Used for E2E testing with Playwright

# ============================================
# Test Database (isolated from dev/prod)
# ============================================
DATABASE_URL="postgresql://familyhub:testpassword@localhost:5433/familyhub_test"

# ============================================
# Security (test values)
# ============================================
BETTER_AUTH_SECRET="test-secret-do-not-use-in-production-ever"

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# ============================================
# Storage (test mode - local only)
# ============================================
STORAGE_TYPE=local
UPLOAD_DIR=/tmp/familyhub-test-uploads

# ============================================
# Test Mode
# ============================================
NODE_ENV=test
