# Family Hub Environment Configuration
# Copy to .env and customize for your setup

# ============================================
# REQUIRED - Database
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://familyhub:changeme@localhost:5432/familyhub

# Database password (used by Docker Compose)
DB_PASSWORD=changeme

# ============================================
# REQUIRED - Security
# ============================================
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production

# ============================================
# Application Settings
# ============================================
# Node environment: production | development
NODE_ENV=production

# Port to run the application
PORT=3000

# ============================================
# File Storage
# ============================================
# Storage type: local | s3
STORAGE_TYPE=local

# Local storage directory (absolute path)
UPLOAD_DIR=/app/uploads

# Maximum file upload size (bytes)
MAX_FILE_SIZE=5242880

# S3 Configuration (only if STORAGE_TYPE=s3)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=familyhub-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ============================================
# Resource Limits
# ============================================
# Maximum members per family
MAX_MEMBERS=10

# Maximum active chores per family
MAX_CHORES=100

# Maximum active todos per family
MAX_TODOS=200

# Maximum storage per family (MB)
MAX_STORAGE_MB=1024

# ============================================
# Feature Flags (v0.1+)
# ============================================
# Allow new family registration
ALLOW_REGISTRATION=true

# Enable photo uploads for chore completion
ENABLE_PHOTOS=true

# Enable points/rewards system
ENABLE_POINTS=true

# Debug mode (verbose logging)
DEBUG_MODE=false

# ============================================
# Optional: Email (v0.2+)
# ============================================
# SMTP host for email notifications
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@familyhub.local

# ============================================
# Optional: Home Assistant (v0.3+)
# ============================================
# Home Assistant webhook URL for notifications
# HOME_ASSISTANT_WEBHOOK_URL=
