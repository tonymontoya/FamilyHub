# Family Hub - Production Environment
# Copy to .env and customize for your deployment

# ============================================
# REQUIRED - Database
# ============================================
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/familyhub"

# ============================================
# REQUIRED - Security
# ============================================
# Generate with: openssl rand -base64 32
# Must be at least 32 characters - DO NOT USE THIS DEFAULT IN PRODUCTION
BETTER_AUTH_SECRET="change-me-to-a-32-character-random-string-in-production"

# ============================================
# REQUIRED - Application URLs
# ============================================
# Your public-facing URL
NEXT_PUBLIC_APP_URL="https://familyhub.yourdomain.com"
BETTER_AUTH_URL="https://familyhub.yourdomain.com"

# ============================================
# Application Settings
# ============================================
NODE_ENV="production"
PORT=3000

# ============================================
# File Storage
# ============================================
# Storage type: local | s3
STORAGE_TYPE=local

# Local storage directory (absolute path in container)
UPLOAD_DIR=/app/uploads

# Maximum file upload size (bytes)
MAX_FILE_SIZE=5242880

# ============================================
# Resource Limits
# ============================================
MAX_MEMBERS=10
MAX_CHORES=100
MAX_TODOS=200
MAX_STORAGE_MB=1024
