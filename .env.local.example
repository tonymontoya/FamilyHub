# Family Hub - Local Development Environment
# Copy to .env.local and customize

# ============================================
# REQUIRED - Database
# ============================================
# PostgreSQL connection string for development
DATABASE_URL="postgresql://familyhub:devpassword@localhost:5432/familyhub_dev"

# ============================================
# REQUIRED - Security
# ============================================
# Generate with: openssl rand -base64 32
# Must be at least 32 characters
BETTER_AUTH_SECRET="dev-secret-not-for-production-change-me"

# ============================================
# Application Settings
# ============================================
NODE_ENV="development"
PORT=3000

# ============================================
# File Storage (Development)
# ============================================
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ============================================
# Resource Limits (Development)
# ============================================
MAX_MEMBERS=10
MAX_CHORES=100
MAX_TODOS=200
MAX_STORAGE_MB=1024
